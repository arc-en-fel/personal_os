{
  "expo": {
    "name": "orbi",
    "slug": "personal-os",
    "version": "1.0.6",
    "orientation": "portrait",
    "scheme": "personalos",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon-1024x1024.png",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7714932c-6dfa-4bcc-87f4-bc0b0b6ae2ce",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon-1024x1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-1024x1024.png",
        "backgroundColor": "#607A62"
      },
      "package": "com.deepak_bhaskaran.personalos"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7714932c-6dfa-4bcc-87f4-bc0b0b6ae2ce"
      }
    },
    "owner": "deepak_bhaskaran"
  }
}
